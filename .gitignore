# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
web/.next/
web/out/
web/tsconfig.tsbuildinfo
npm-debug.log*

# --- Env & secrets ---
.env
.env.local
.env.*.local
!web/.env.local.example

# --- Generated data & packages ---
backend/data/*.db
backend/data/*.sqlite*
backend/packages/
backend/ml/artifacts/*.jsonl


# --- Editors / OS / misc ---
# Workspace settings and recommended extensions are shared on purpose: they pin
# the interpreter, so Pylance resolves third-party imports for every teammate.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

