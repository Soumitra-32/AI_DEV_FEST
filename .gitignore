# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
web/.next/
web/out/
web/coverage/
coverage/
web/tsconfig.tsbuildinfo
npm-debug.log*

# --- Env & secrets ---
.env
.env.local
.env.*.local
!web/.env.local.example

# --- Generated data & packages ---
backend/data/*.db
backend/data/*.sqlite*
backend/packages/
backend/ml/artifacts/*.jsonl


# --- Tooling scratch (never part of the submission) ---
# Editor/agent worktrees and duplicated checkouts of this repo.
.kilo/
.kilocode/
# Type-checker and diff dumps written to the repo root by ad-hoc runs.
_pyright*.json
_before.json
_after.json
_bak_*.py
_diag_*.py


# --- Editors / OS / misc ---
# Workspace settings and recommended extensions are shared on purpose: they pin
# the interpreter, so Pylance resolves third-party imports for every teammate.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

_diag_*.py
