# Keep the build context small: venvs, deps, data and secrets never enter images.
.venv/
venv/
web/node_modules/
web/.next/
.git/
backend/.venv/
backend/data/*.db
backend/data/*.sqlite*
backend/__pycache__/
**/__pycache__/
.env
.env.local
web/.env.local
*.log

# Tooling scratch: agent worktrees are full copies of the repo and must
# never enter the build context.
.kilo/
.kilocode/
.gitignore
.gitattributes
plan.txt
