# ============================================================
# Shonchoy Copilot — environment variables (copy to .env)
# Nothing here is real. LLM keys are optional: the template
# fallback works without them.
# ============================================================

# --- Backend (FastAPI) ---
PORT=8000
# Demo auth token; deps.py maps it to a user_id (never from the request body)
DEMO_AUTH_TOKEN=your-random-token-here

# Allowed browser origins (comma-separated). For production, add your Vercel domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# --- Frontend (Next.js, web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DEMO_TOKEN=your-random-token-here

# --- LLM (optional; template fallback works without any keys) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_BACKUP_API_KEY_1=
LLM_BACKUP_BASE_URL_1=
LLM_BACKUP_MODEL_1=
LLM_BACKUP_API_KEY_2=
LLM_BACKUP_BASE_URL_2=
LLM_BACKUP_MODEL_2=

# --- Feature flags (toggled in app/config.py) ---
FEATURE_VOICE=true
FEATURE_SIGNAL=true
FEATURE_TIPS=true
FEATURE_LLM_INTENT=true
