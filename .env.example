# ============================================================
# Shonchoy Copilot — environment variables (copy to .env)
# Nothing here is real. LLM keys are optional: the template
# fallback (Phase 4) works without them.
# ============================================================

# --- Backend (FastAPI) ---
PORT=8000
# Demo auth token; deps.py maps it to a user_id (never from the request body)
DEMO_AUTH_TOKEN=change-me

# --- Frontend (Next.js, web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DEMO_TOKEN=change-me

# --- LLM (optional; the template fallback works with no key at all) ---
# One primary key plus two backups, tried in order. Each backup may also
# override the base URL and model, so it can be a different provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_BACKUP_API_KEY_1=
LLM_BACKUP_BASE_URL_1=
LLM_BACKUP_MODEL_1=
LLM_BACKUP_API_KEY_2=
LLM_BACKUP_BASE_URL_2=
LLM_BACKUP_MODEL_2=

# --- Feature flags (toggled in app/config.py) ---
FEATURE_VOICE=true
FEATURE_SIGNAL=true
FEATURE_TIPS=true
# The LLM intent classifier for chat and voice (use 3). Off = keyword matching.
FEATURE_LLM_INTENT=true

