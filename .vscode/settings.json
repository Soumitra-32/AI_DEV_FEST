{
  // Point the language server and the test runner at the workspace virtualenv.
  // Without this, Pylance resolves imports against whatever Python VS Code
  // auto-detected and every third-party import shows up as
  // "Import \"fastapi\" could not be resolved (reportMissingImports)".
  // Setup: python -m venv .venv && .venv/Scripts/python -m pip install -r backend/requirements.txt
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "error",
    "reportUnusedImport": "warning"
  },
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["backend/tests"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/.next": true,
    "backend/ml/artifacts": true,
    "backend/data/*.db": true
  },
  "editor.rulers": [100],
  "files.eol": "\n"
}